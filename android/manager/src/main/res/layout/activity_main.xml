<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/moon"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/pinButton"
                style="@style/SmallButton"
                android:text="@string/pin_button" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:paddingVertical="8dp"
            android:textColor="@color/dim"
            android:textSize="14sp" />

        <!-- Now playing -->
        <LinearLayout style="@style/Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Label"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/now_playing" />

                <!-- Needs a player with protocol 3 and a music app that shares its queue -->
                <Button
                    android:id="@+id/queueButton"
                    style="@style/SmallButton"
                    android:layout_marginVertical="-8dp"
                    android:text="@string/queue"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Cover; protocol 3. Slightly dimmed: the screen is used in the dark. -->
                <ImageView
                    android:id="@+id/cover"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_marginEnd="14dp"
                    android:alpha="0.85"
                    android:background="@drawable/cover_bg"
                    android:contentDescription="@string/cover"
                    android:outlineProvider="background"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@color/text"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/dim"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Progress; hidden when the music app does not report it -->
            <LinearLayout
                android:id="@+id/progressGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <SeekBar
                    android:id="@+id/positionBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:id="@+id/elapsed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/dim"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/dim"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/prev"
                    style="@style/RoundButton"
                    android:contentDescription="@string/previous"
                    android:src="@drawable/ic_skip_previous" />

                <ImageButton
                    android:id="@+id/toggle"
                    style="@style/RoundButton"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_marginHorizontal="24dp"
                    android:background="@drawable/btn_round_accent"
                    android:contentDescription="@string/play"
                    android:src="@drawable/ic_play"
                    android:tint="@color/background" />

                <ImageButton
                    android:id="@+id/next"
                    style="@style/RoundButton"
                    android:contentDescription="@string/next"
                    android:src="@drawable/ic_skip_next" />
            </LinearLayout>

            <!-- Shuffle, -15 s, +15 s, repeat; each hidden when not supported -->
            <LinearLayout
                android:id="@+id/extraControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/shuffle"
                    style="@style/SmallRoundButton"
                    android:layout_marginHorizontal="10dp"
                    android:contentDescription="@string/shuffle"
                    android:src="@drawable/ic_shuffle" />

                <Button
                    android:id="@+id/rewind"
                    style="@style/SmallRoundText"
                    android:layout_marginHorizontal="10dp" />

                <Button
                    android:id="@+id/forward"
                    style="@style/SmallRoundText"
                    android:layout_marginHorizontal="10dp" />

                <ImageButton
                    android:id="@+id/repeat"
                    style="@style/SmallRoundButton"
                    android:layout_marginHorizontal="10dp"
                    android:contentDescription="@string/repeat"
                    android:src="@drawable/ic_repeat" />
            </LinearLayout>
        </LinearLayout>

        <!-- Volume -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/Label"
                android:text="@string/volume_label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/volDown"
                    style="@style/RoundButton"
                    android:contentDescription="@string/volume_down"
                    android:src="@drawable/ic_minus" />

                <TextView
                    android:id="@+id/volumeText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/text"
                    android:textSize="36sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/volUp"
                    style="@style/RoundButton"
                    android:contentDescription="@string/volume_up"
                    android:src="@drawable/ic_plus" />
            </LinearLayout>

            <TextView
                android:id="@+id/volumeSteps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/dim"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/volumeBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="32dp" />

            <!-- Volume limit; needs a player with protocol 2 -->
            <LinearLayout
                android:id="@+id/capRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/capText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/dim"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/capDown"
                    style="@style/SmallRoundButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="10dp"
                    android:contentDescription="@string/cap_down"
                    android:src="@drawable/ic_minus" />

                <ImageButton
                    android:id="@+id/capUp"
                    style="@style/SmallRoundButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="12dp"
                    android:padding="10dp"
                    android:contentDescription="@string/cap_up"
                    android:src="@drawable/ic_plus" />
            </LinearLayout>
        </LinearLayout>

        <!-- Sleep timer; needs a player with protocol 2 -->
        <LinearLayout
            android:id="@+id/sleepCard"
            style="@style/Card"
            android:visibility="gone">

            <TextView
                style="@style/Label"
                android:text="@string/sleep_label" />

            <LinearLayout
                android:id="@+id/sleepOff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/sleepChoices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="-3dp"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal" />

                <CheckBox
                    android:id="@+id/sleepFade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:buttonTint="@color/moon"
                    android:text="@string/sleep_fade"
                    android:textColor="@color/text"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sleepOn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/sleepRemaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/text"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/sleepDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/dim"
                        android:textSize="13sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/sleepCancel"
                    style="@style/SmallButton"
                    android:text="@string/cancel" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/battery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/no_access"
            android:textColor="@color/bad"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/keys_hint"
            android:textColor="@color/dim"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
